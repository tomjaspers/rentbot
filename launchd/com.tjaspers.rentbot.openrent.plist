<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Laptop worker: scans only OpenRent (which blocks GitHub Actions) into the shared Neon database.
     Turn on/off with scripts/laptop.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tjaspers.rentbot.openrent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/tjaspers/Projects/house</string>
        <string>rentbot</string>
        <string>run</string>
        <string>--sources</string>
        <string>openrent</string>
        <string>--runner</string>
        <string>laptop</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/tjaspers/Projects/house</string>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/tjaspers/Library/Logs/rentbot-openrent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tjaspers/Library/Logs/rentbot-openrent.log</string>
</dict>
</plist>
